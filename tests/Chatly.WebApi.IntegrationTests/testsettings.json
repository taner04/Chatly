{
  "TestContainers": {
    "PostgresImage": "postgres:18.3",
    "AzuriteImage": "mcr.microsoft.com/azure-storage/azurite:3.37.0"
  },
  "WebApi": {
    "OidcOption": {
      "Authority": "https://identity.chatly.tests/realms/chatly",
      "Audience": "chatly-api",
      "ClientId": "chatly-tests",
      "BackchannelLogoutAudience": "chatly-desktop",
      "UsePersistentStorage": "false"
    },
    "IdentityAdminOption": {
      "ClientId": "chatly-api",
      "ClientSecret": "chatly-tests-secret"
    },
    "EmailOption": {
      "Host": "localhost",
      "Port": "2525",
      "SenderName": "Chatly Tests",
      "SenderEmail": "noreply@chatly.tests",
      "UseSsl": "false"
    },
    "LiveKitOption": {
      "ServerUrl": "ws://livekit.tests",
      "ApiKey": "chatly-tests",
      "ApiSecret": "chatly-integration-tests-livekit-secret"
    },
    "Hangfire": {
      "ServerEnabled": "false"
    }
  }
}
