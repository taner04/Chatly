<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ChatlyWindowBrush" Color="#202124" />
    <SolidColorBrush x:Key="ChatlySidebarBrush" Color="#1B1C1E" />
    <SolidColorBrush x:Key="ChatlyContentBrush" Color="#2A2B2E" />
    <SolidColorBrush x:Key="ChatlyElevatedBrush" Color="#303136" />
    <SolidColorBrush x:Key="ChatlyBorderBrush" Color="#414247" />
    <SolidColorBrush x:Key="ChatlyHoverBrush" Color="#363A42" />
    <SolidColorBrush x:Key="ChatlyAccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="ChatlyTextBrush" Color="#F1F3F4" />
    <SolidColorBrush x:Key="ChatlyMutedTextBrush" Color="#B8BBC1" />
</ResourceDictionary>