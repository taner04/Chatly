<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Border.list-row">
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{DynamicResource ChatlyElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.list-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
    </Style>
    <Style Selector="Border.chat-row">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Background" Value="{DynamicResource ChatlyElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.chat-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
    </Style>
</Styles>