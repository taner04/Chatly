<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="TextBox.chatly-input">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ChatlyContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBox.chatly-input:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyAccentBrush}" />
    </Style>
</Styles>
