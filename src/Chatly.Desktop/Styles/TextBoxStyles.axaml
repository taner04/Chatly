<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="TextBox.chatly-input">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ChatlyContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ChatlyAccentBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ChatlyOnAccentBrush}" />
    </Style>
    <Style Selector="TextBox.chatly-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyAccentBrush}" />
    </Style>
</Styles>