<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="TextBox.chatly-input">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ChatlyContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBox.chatly-input:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource ChatlyAccentBrush}" />
    </Style>
    <Style Selector="TextBox.friend-search">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
    </Style>
</Styles>