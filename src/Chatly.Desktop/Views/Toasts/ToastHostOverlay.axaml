<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Chatly.Desktop.Views.Toasts"
             xmlns:toastViews="using:Chatly.Desktop.Views.Toasts"
             xmlns:vm="using:Chatly.Desktop.ViewModels.Toasts"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chatly.Desktop.Views.Toasts.ToastHostOverlay"
             x:DataType="local:ToastHostOverlay">
    <UserControl.Styles>
        <Style Selector="Border.toast-card">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.toast-icon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.toast-icon ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
        </Style>
    </UserControl.Styles>

    <ItemsControl ItemsSource="{Binding ViewModel.Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,20,20,0">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <toastViews:AnimatedToastPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToastNotificationViewModel">
                <Border Classes="toast-card"
                        Width="400"
                        Margin="0,0,0,10"
                        Padding="16"
                        Background="{DynamicResource ChatlyElevatedBrush}"
                        BorderBrush="{DynamicResource ChatlyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        BoxShadow="0 8 24 0 #40000000">
                    <Grid ColumnDefinitions="36,*,28" ColumnSpacing="12">
                        <Border Classes="toast-icon"
                                Classes.success="{Binding IsSuccess}"
                                Classes.error="{Binding IsError}"
                                VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="{Binding Icon}"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ChatlyTextBrush}" />
                            <TextBlock Text="{Binding Message}"
                                       FontSize="12"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="icon-button toast-dismiss"
                                Command="{Binding DismissCommand}"
                                VerticalAlignment="Top"
                                ToolTip.Tip="Dismiss">
                            <ic:SymbolIcon Symbol="Dismiss"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>