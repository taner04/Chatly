<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chatly.Desktop.ViewModels"
             x:Class="Chatly.Desktop.Views.LoginPageView"
             x:DataType="vm:LoginPageViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Background="{DynamicResource ChatlyElevatedBrush}"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="6">
                <TextBlock Text="Sign in"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ChatlyTextBrush}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource ChatlyMutedTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ChatlyElevatedBrush}"
                BorderBrush="{DynamicResource ChatlyBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="32">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="Complete sign-in in your browser."
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ChatlyTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="You can return to Chatly after authentication."
                           Foreground="{DynamicResource ChatlyMutedTextBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
