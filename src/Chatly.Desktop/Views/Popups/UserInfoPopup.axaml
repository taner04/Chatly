<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:controls="using:Chatly.Desktop.Views.Controls"
              xmlns:ic="using:FluentIcons.Avalonia"
              xmlns:local="using:Chatly.Desktop.Views.Popups"
              mc:Ignorable="d"
              d:DesignWidth="492"
              d:DesignHeight="390"
              x:Class="Chatly.Desktop.Views.Popups.UserInfoPopup"
              x:DataType="local:UserInfoPopup"
              x:Name="Root">
    <UserControl.Styles>
        <Style Selector="Border.profile-card">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource ChatlyContentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="TextBlock.detail-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.detail-value">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
        </Style>
        <Style Selector="Button.avatar-select">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.avatar-select:pointerover">
            <Setter Property="Background" Value="#220A84FF" />
        </Style>
        <Style Selector="Button.remove-picture">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ChatlyElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.profile-cancel">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
        </Style>
        <Style Selector="Button.profile-cancel:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
        </Style>
        <Style Selector="Button.profile-save">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <Border Classes="profile-card">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                <Grid Width="98" Height="98">
                    <Grid Width="92" Height="92">
                        <controls:UserAvatar Width="92"
                                             Height="92"
                                             DisplayName="{Binding ViewModel.OriginalUsername}"
                                             ProfilePictureUrl="{Binding ViewModel.VisibleProfilePictureUrl}" />
                        <Border CornerRadius="46"
                                ClipToBounds="True"
                                IsVisible="{Binding ViewModel.HasProfilePicturePreview}">
                            <Image Source="{Binding ViewModel.ProfilePicturePreview}"
                                   Stretch="UniformToFill" />
                        </Border>
                        <Button Classes="avatar-select"
                                Command="{Binding ViewModel.SelectProfilePictureCommand}"
                                CommandParameter="{Binding #Root}"
                                ToolTip.Tip="Choose profile picture" />
                        <Border Width="25"
                                Height="25"
                                CornerRadius="13"
                                Background="{DynamicResource ChatlyElevatedBrush}"
                                BorderBrush="#636366"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                            <ic:SymbolIcon Symbol="Edit"
                                           FontSize="13"
                                           Foreground="White" />
                        </Border>
                    </Grid>
                    <Button Classes="remove-picture"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsVisible="{Binding ViewModel.HasProfilePicture}"
                            Command="{Binding ViewModel.RemoveProfilePictureCommand}"
                            ToolTip.Tip="Remove profile picture">
                        <ic:SymbolIcon Symbol="Dismiss"
                                       FontSize="13"
                                       Foreground="{DynamicResource ChatlyTextBrush}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Column="1"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.OriginalUsername}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ChatlyTextBrush}" />
                    <TextBlock Text="{Binding ViewModel.User.Email}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                    <TextBlock Text="Click the picture to choose a new one."
                               FontSize="11"
                               Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Classes="profile-card">
            <StackPanel Spacing="16">
                <TextBlock Text="ACCOUNT DETAILS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ChatlyMutedTextBrush}" />

                <StackPanel Spacing="5">
                    <TextBlock Classes="detail-label" Text="Username" />
                    <TextBox Classes="chatly-input"
                             Height="40"
                             Padding="12,0"
                             Text="{Binding ViewModel.Username, Mode=TwoWay}"
                             MaxLength="32" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource ChatlyBorderBrush}" />

                <StackPanel Spacing="5">
                    <TextBlock Classes="detail-label" Text="Email address" />
                    <TextBlock Classes="detail-value"
                               Text="{Binding ViewModel.User.Email}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource ChatlyBorderBrush}" />

                <StackPanel Spacing="5">
                    <TextBlock Classes="detail-label" Text="User ID" />
                    <TextBlock Classes="detail-value"
                               Text="{Binding ViewModel.User.Id}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Button Grid.Column="1"
                    Classes="profile-cancel"
                    Content="Cancel"
                    Command="{Binding ViewModel.CancelCommand}" />
            <Button Grid.Column="2"
                    Classes="accent-button opacity-hover profile-save"
                    Content="Save"
                    Command="{Binding ViewModel.SaveCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
