<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chatly.Desktop.ViewModels.Pages"
             x:Class="Chatly.Desktop.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">

    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title}"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ChatlyTextBrush}" />
        <TextBlock Text="{Binding Description}"
                   FontSize="16"
                   Foreground="{DynamicResource ChatlyMutedTextBrush}" />
    </StackPanel>

</UserControl>
