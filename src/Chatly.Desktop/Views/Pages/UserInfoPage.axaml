<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="using:Chatly.Desktop.Views.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages:UserInfoPage"
             x:Class="Chatly.Desktop.Views.Pages.UserInfoPage">

<Image asyncImageLoader:ImageLoader.Source="{Binding ViewModel.UserContext.CurrentUser.ProfilePictureUrl}" />

</UserControl>
