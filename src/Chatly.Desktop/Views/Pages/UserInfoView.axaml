<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:pages="using:Chatly.Desktop.Views.Pages"
              xmlns:controls="using:Chatly.Desktop.Views.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages:UserInfoView"
             x:Class="Chatly.Desktop.Views.Pages.UserInfoView">

    <controls:UserAvatar Width="96"
                         Height="96"
                         ProfilePictureUrl="{Binding ViewModel.UserContext.CurrentUser.ProfilePictureUrl}"
                         DisplayName="{Binding ViewModel.UserContext.CurrentUser.Username}" />

</UserControl>
