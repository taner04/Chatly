<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="using:Chatly.Desktop.Views.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:Chatly.Desktop.ViewModels.Pages.UserPage"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:UserPageViewModel"
             x:ClassModifier="internal"
             x:Class="Chatly.Desktop.Views.Pages.UserPage.UserPage">
    <UserControl.Styles>
        <Style Selector="Button.current-user-profile">
            <Setter Property="Background" Value="{DynamicResource ChatlyElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Button.current-user-profile:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
        </Style>
        <Style Selector="Border.pending-request-badge">
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <Button Classes="current-user-profile"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenCurrentUserProfileCommand}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:UserAvatar Width="56"
                                         Height="56"
                                         ProfilePictureUrl="{Binding UserContext.CurrentUser.ProfilePictureUrl}"
                                         DisplayName="{Binding UserContext.CurrentUser.Username}" />
                    <TextBlock Text="{Binding UserContext.CurrentUser.Username}"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ChatlyTextBrush}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Classes="fluent-button add-friend"
                    Content="Add Friend"
                    Command="{Binding AddFriendCommand}" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <TabStrip SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Online Friends" />
                <TabItem Header="All Friends" />
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Pending Requests"
                                       VerticalAlignment="Center" />
                            <Border Classes="pending-request-badge"
                                    IsVisible="{Binding FriendRequestState.HasPendingRequests}">
                                <TextBlock Text="{Binding FriendRequestState.PendingCount}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ChatlyTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabStrip>
            <ContentControl Content="{Binding CurrentTab}" Grid.Row="1" Margin="0,16,0,0" />
        </Grid>
    </Grid>

</UserControl>