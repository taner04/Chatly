<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:Chatly.Desktop.Views.Controls"
             xmlns:users="using:Chatly.Desktop.ViewModels.Pages.UserPage.Popups"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:ClassModifier="internal"
             x:Class="Chatly.Desktop.Views.Pages.UserPage.Popups.AddFriendPopupOverlay"
             x:DataType="users:AddFriendPopupOverlayViewModel"
             MinWidth="440"
             MaxWidth="720"
             MaxHeight="560">
    <UserControl.Styles>
        <Style Selector="TextBox.add-friend-search">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0,48,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
        </Style>
        <Style Selector="Button.search-button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.add-request-button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyOnAccentBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="StackPanel.empty-state">
            <Setter Property="Spacing" Value="6" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.empty-state-icon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.empty-state-icon ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource ChatlyMutedTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.empty-state-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
        </Style>
        <Style Selector="TextBlock.empty-state-message">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MaxWidth" Value="300" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyMutedTextBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SearchForUsersCommand}" />
    </UserControl.KeyBindings>

    <StackPanel Spacing="20">
        <StackPanel Spacing="5">
            <TextBlock Text="Find someone to chat with"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ChatlyTextBrush}" />
            <TextBlock Text="Search by their username to send a friend request."
                       FontSize="13"
                       Foreground="{DynamicResource ChatlyMutedTextBrush}" />
        </StackPanel>

        <Grid>
            <TextBox Classes="chatly-input add-friend-search"
                     Text="{Binding UserName, Mode=TwoWay}"
                     PlaceholderText="Search by username" />
            <Button Classes="icon-button search-button"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,7,0"
                    ToolTip.Tip="Search"
                    Command="{Binding SearchForUsersCommand}">
                <ic:SymbolIcon Symbol="Search" FontSize="17" />
            </Button>
        </Grid>

        <Border Height="1"
                Background="{DynamicResource ChatlyBorderBrush}" />

        <ScrollViewer MaxHeight="300"
                      IsVisible="{Binding HasSearchResults}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding SearchedUsers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="users:UserSearchResultViewModel">
                            <Border Classes="list-row" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                                    <controls:UserAvatar Width="40"
                                                         Height="40"
                                                         ProfilePictureUrl="{Binding ProfilePictureUrl}"
                                                         DisplayName="{Binding Username}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ChatlyTextBrush}" />
                                        <TextBlock Text="Chatly user"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="accent-button opacity-hover add-request-button"
                                            VerticalAlignment="Center"
                                            Command="{Binding SendFriendRequestCommand}"
                                            IsVisible="{Binding CanSendFriendRequest}"
                                            ToolTip.Tip="Add friend">
                                        <Grid Width="12" Height="12">
                                            <Border Width="12"
                                                    Height="2"
                                                    CornerRadius="1"
                                                    Background="{DynamicResource ChatlyOnAccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            <Border Width="2"
                                                    Height="12"
                                                    CornerRadius="1"
                                                    Background="{DynamicResource ChatlyOnAccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RelationshipLabel}"
                                               IsVisible="{Binding !CanSendFriendRequest}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Load more"
                        Classes="load-more-button"
                        Command="{Binding LoadMoreUsersCommand}"
                        IsVisible="{Binding HasMoreUsers}"
                        IsEnabled="{Binding !IsSearching}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,8" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock Text="Searching..."
                   IsVisible="{Binding IsSearching}"
                   FontSize="13"
                   Foreground="{DynamicResource ChatlyMutedTextBrush}"
                   HorizontalAlignment="Center" />
        <StackPanel Classes="empty-state" IsVisible="{Binding ShowSearchPrompt}">
            <Border Classes="empty-state-icon">
                <ic:SymbolIcon Symbol="PersonSearch" FontSize="24" />
            </Border>
            <TextBlock Classes="empty-state-title" Text="Start searching" />
            <TextBlock Classes="empty-state-message"
                       Text="Type a username and press Enter to find people to add." />
        </StackPanel>
        <StackPanel Classes="empty-state" IsVisible="{Binding HasNoSearchResults}">
            <Border Classes="empty-state-icon">
                <ic:SymbolIcon Symbol="PersonProhibited" FontSize="24" />
            </Border>
            <TextBlock Classes="empty-state-title" Text="No users found" />
            <TextBlock Classes="empty-state-message"
                       Text="Check the spelling or try a different username." />
        </StackPanel>
    </StackPanel>
</UserControl>