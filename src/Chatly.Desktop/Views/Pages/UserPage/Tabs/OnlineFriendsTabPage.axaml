<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Chatly.Desktop.Views.Pages.UserPage.Tabs"
             xmlns:viewModels="using:Chatly.Desktop.ViewModels.Pages.UserPage.Tabs"
             x:ClassModifier="internal"
             x:Class="Chatly.Desktop.Views.Pages.UserPage.Tabs.OnlineFriendsTabPage"
             x:DataType="viewModels:OnlineFriendsTabPageViewModel">
    <local:FriendsTabView ViewModel="{Binding}"
                          ShowCallButton="True" />
</UserControl>