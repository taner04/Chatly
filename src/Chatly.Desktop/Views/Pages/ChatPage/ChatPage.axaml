<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chatly.Desktop.ViewModels.Pages.ChatPage"
             xmlns:tabs="using:Chatly.Desktop.Views.Pages.ChatPage.Tabs"
             x:Class="Chatly.Desktop.Views.Pages.ChatPage.ChatPage"
             x:DataType="vm:ChatPageViewModel">

    <Grid ColumnDefinitions="256,*">
        <Border Padding="16"
                Background="{DynamicResource ChatlyContentBrush}"
                BorderBrush="{DynamicResource ChatlyBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="16,0,0,16">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <TextBlock Text="Chats"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ChatlyTextBrush}" />

                <TextBox Grid.Row="1"
                         PlaceholderText="Search conversations"
                         Background="{DynamicResource ChatlyElevatedBrush}"
                         BorderBrush="{DynamicResource ChatlyBorderBrush}" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Chats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatPreviewViewModel">
                            <Border Classes="list-row"
                                    Margin="0,0,0,8"
                                    >
                                <Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Border Width="40"
                                            Height="40"
                                            Background="{DynamicResource ChatlyAccentBrush}"
                                            CornerRadius="20">
                                        <TextBlock Text="{Binding Initials}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ChatlyTextBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Time}"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Preview}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ChatlyMutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <TabControl Grid.Column="1" Padding="20">
            <TabItem Header="Online Friends">
                <tabs:FriendsTabView DataContext="{Binding OnlineFriends}" />
            </TabItem>
            <TabItem Header="All Friends">
                <tabs:FriendsTabView DataContext="{Binding AllFriends}" />
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
