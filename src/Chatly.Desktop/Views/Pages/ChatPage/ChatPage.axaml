<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Chatly.Desktop.Views.Controls"
             xmlns:viewModels="using:Chatly.Desktop.ViewModels.Pages.ChatPage"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:converters="using:Chatly.Desktop.Converters"
             xmlns:messages="clr-namespace:Chatly.Desktop.ViewModels.Pages.ChatPage.Messages"
             x:ClassModifier="internal"
             x:Class="Chatly.Desktop.Views.Pages.ChatPage.ChatPage"
             x:DataType="viewModels:ChatPageViewModel">
    <UserControl.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type messages:ChatMessageViewModel}">
            <controls:ChatMessageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DraftAttachmentViewModel}">
            <Border Width="210"
                    Padding="9"
                    Background="{DynamicResource ChatlyContentBrush}"
                    BorderBrush="{DynamicResource ChatlyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid ColumnDefinitions="32,*,24" ColumnSpacing="8">
                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource ChatlyElevatedBrush}"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <Image
                                asyncImageLoader:ImageLoader.Source="{Binding PreviewUrl, Converter={StaticResource ImageUrlConverter}}"
                                IsVisible="{Binding IsImage}"
                                Stretch="UniformToFill" />
                            <ic:SymbolIcon Symbol="Document"
                                           IsVisible="{Binding IsFile}"
                                           FontSize="17"
                                           Foreground="{DynamicResource ChatlyAccentBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ChatlyTextBrush}" />
                        <TextBlock Text="{Binding SizeText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.RemoveDraftAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="13" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="Button.chat-row-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chat-row-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.chat-message">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style Selector="Button.send-message">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.typing-dot">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource ChatlyMutedTextBrush}" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.typing-dot.first">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="20%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.typing-dot.second">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="20%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.typing-dot.third">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="80%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220,*" ColumnSpacing="20">
        <Border Background="{DynamicResource ChatlyElevatedBrush}"
                BorderBrush="{DynamicResource ChatlyBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <ItemsControl Classes="stretch-items"
                          ItemsSource="{Binding Chats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="chat-row-button"
                                Command="{Binding NavigateCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <Border Classes="chat-row"
                                    Classes.selected="{Binding IsSelected}"
                                    Padding="0"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Border Width="3"
                                            Height="24"
                                            Background="{DynamicResource ChatlyAccentBrush}"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsSelected}" />
                                    <Grid Margin="10,9"
                                          ColumnDefinitions="44,*,Auto"
                                          ColumnSpacing="8">
                                        <controls:UserAvatar Width="40"
                                                             Height="40"
                                                             DisplayName="{Binding Name}"
                                                             ProfilePictureUrl="{Binding User.ProfilePictureUrl}"
                                                             IsOnline="{Binding User.IsOnline}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ChatlyTextBrush}" />
                                        <controls:UnreadBadge Grid.Column="2"
                                                              Count="{Binding UnreadMessageCount}"
                                                              VerticalAlignment="Center"
                                                              IsVisible="{Binding HasUnreadMessages}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" DragDrop.AllowDrop="True" Name="DropTargetGrid">
            <Border Grid.Row="0"
                    Padding="16,12"
                    Background="{DynamicResource ChatlyElevatedBrush}"
                    BorderBrush="{DynamicResource ChatlyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    IsVisible="{Binding HasCurrentChat}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <controls:UserAvatar Width="32"
                                         Height="32"
                                         DisplayName="{Binding CurrentChat.User.Username}"
                                         ProfilePictureUrl="{Binding CurrentChat.User.ProfilePictureUrl}"
                                         IsOnline="{Binding CurrentChat.User.IsOnline}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentChat.Name}"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ChatlyTextBrush}" />
                    <Button Grid.Column="2"
                            Classes="icon-button friend-action"
                            ToolTip.Tip="Call"
                            Command="{Binding Call.CallCommand}"
                            CommandParameter="{Binding CurrentChat.User}">
                        <ic:SymbolIcon Symbol="Call" FontSize="18" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScrollViewer"
                          Grid.Row="1"
                          Margin="0,12"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="MessagesScrollViewer_OnScrollChanged"
                          IsVisible="{Binding HasCurrentChat}">
                <StackPanel>
                    <TextBlock Text="Loading messages..."
                               HorizontalAlignment="Center"
                               Margin="0,16"
                               Foreground="{DynamicResource ChatlyMutedTextBrush}"
                               IsVisible="{Binding MessagesViewModel.IsLoadingMessages}" />

                    <TextBlock Text="No messages yet. Start the conversation."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,28"
                               Foreground="{DynamicResource ChatlyMutedTextBrush}"
                               IsVisible="{Binding MessagesViewModel.IsEmptyChat}" />

                    <ItemsControl Classes="stretch-items"
                                  ItemsSource="{Binding MessagesViewModel.Messages}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="10"
                    Background="{DynamicResource ChatlyElevatedBrush}"
                    BorderBrush="{DynamicResource ChatlyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    IsVisible="{Binding HasCurrentChat}">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="10"
                      VerticalAlignment="Center">
                    <StackPanel Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="5"
                                Margin="4,0,4,7"
                                VerticalAlignment="Center"
                                IsVisible="{Binding TypingViewModel.IsOtherUserTyping}">
                        <TextBlock FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ChatlyMutedTextBrush}">
                            <Run Text="{Binding CurrentChat.Name}" FontWeight="SemiBold" />
                            <Run Text=" is typing" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <Border Classes="typing-dot first" />
                            <Border Classes="typing-dot second" />
                            <Border Classes="typing-dot third" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="3" Grid.Column="0"
                                  Margin="4,0,4,8"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasDraftAttachments}">
                        <ItemsControl ItemsSource="{Binding DraftAttachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox Classes="chatly-input chat-message"
                             Grid.Row="2" Grid.Column="0"
                             VerticalAlignment="Center"
                             Text="{Binding DraftMessage, Mode=TwoWay}"
                             PlaceholderText="Write a message..."
                             KeyDown="MessageTextBox_OnKeyDown"
                             DragDrop.AllowDrop="True" Name="DropTargetTextBox" />
                    <Button Grid.Column="1"
                            Grid.Row="2"
                            Classes="fluent-button send-message"
                            VerticalAlignment="Center"
                            Command="{Binding AddAttachmentsCommand}"
                            ToolTip.Tip="Add attachments">
                        <ic:SymbolIcon Symbol="Attach" FontSize="19" />
                    </Button>
                    <Button Grid.Column="2"
                            Grid.Row="2"
                            Classes="fluent-button send-message"
                            VerticalAlignment="Center"
                            Command="{Binding SendMessageCommand}"
                            ToolTip.Tip="Send message">
                        <ic:SymbolIcon Symbol="Send" FontSize="19" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>