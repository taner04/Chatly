<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:Chatly.Desktop.ViewModels.Pages.ChatPage"
              xmlns:tabs="using:Chatly.Desktop.Views.Pages.ChatPage.Tabs"
              xmlns:local="using:Chatly.Desktop.Views.Pages.ChatPage"
              xmlns:controls="using:Chatly.Desktop.Views.Controls"
              x:Class="Chatly.Desktop.Views.Pages.ChatPage.ChatPage"
              x:DataType="local:ChatPage">

    <Grid ColumnDefinitions="256,*">
        <Border Padding="16"
                Background="{DynamicResource ChatlyContentBrush}"
                BorderBrush="{DynamicResource ChatlyBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="16,0,0,16">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <TextBlock Text="Chats"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ChatlyTextBrush}" />

                <TextBox Grid.Row="1"
                         PlaceholderText="Search conversations"
                         Background="{DynamicResource ChatlyElevatedBrush}"
                         BorderBrush="{DynamicResource ChatlyBorderBrush}" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding ViewModel.Chats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatPreviewViewModel">
                            <Border Classes="chat-row"
                                    Margin="0,0,0,6"
                                    >
                                <Grid ColumnDefinitions="40,*">
                                    <controls:UserAvatar Width="32"
                                                         Height="32"
                                                         DisplayName="{Binding Name}"
                                                         IsOnline="True" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ChatlyTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <TabControl Grid.Column="1" Padding="20">
            <TabItem Header="Online Friends">
                <tabs:FriendsTabView ViewModel="{Binding ViewModel.OnlineFriends, RelativeSource={RelativeSource AncestorType=local:ChatPage}}" />
            </TabItem>
            <TabItem Header="All Friends">
                <tabs:FriendsTabView ViewModel="{Binding ViewModel.AllFriends, RelativeSource={RelativeSource AncestorType=local:ChatPage}}" />
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
