<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:Chatly.Desktop.Views.Controls"
             xmlns:local="using:Chatly.Desktop.Views.Pages.ChatPage.Tabs"
             x:Class="Chatly.Desktop.Views.Pages.ChatPage.Tabs.PendingFriendRequestTabPage"
             x:DataType="local:PendingFriendRequestTabPage">
    <ItemsControl ItemsSource="{Binding ViewModel.FriendRequests}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="list-row" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="8">
                            <controls:UserAvatar Width="40"
                                                 Height="40"
                                                 DisplayName="{Binding Name}"
                                                 ProfilePictureUrl="{Binding ProfilePictureUrl}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ChatlyTextBrush}" />
                            <Button Grid.Column="2"
                                    Classes="friend-action friend-request-accept"
                                    ToolTip.Tip="Accept friend request">
                                <ic:SymbolIcon Symbol="Checkmark" FontSize="18" />
                            </Button>
                            <Button Grid.Column="3"
                                    Classes="friend-action friend-request-decline"
                                    ToolTip.Tip="Decline friend request">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="18" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
