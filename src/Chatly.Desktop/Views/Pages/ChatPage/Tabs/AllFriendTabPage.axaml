<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chatly.Desktop.ViewModels.Pages.ChatPage.Tabs"
             x:Class="Chatly.Desktop.Views.Pages.ChatPage.Tabs.AllFriendTabPage"
             x:DataType="vm:AllFriendTabPageViewModel">
    <Border MaxWidth="480"
            Padding="20"
            HorizontalAlignment="Left"
            Background="{DynamicResource ChatlyElevatedBrush}"
            BorderBrush="{DynamicResource ChatlyBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel Spacing="16">
            <TextBlock Text="Add Friend"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ChatlyTextBrush}" />
            <TextBlock Text="{Binding HelperText}"
                       Foreground="{DynamicResource ChatlyMutedTextBrush}" />
            <TextBox PlaceholderText="Username"
                     Background="{DynamicResource ChatlyContentBrush}"
                     BorderBrush="{DynamicResource ChatlyBorderBrush}" />
            <Button Content="Send friend request"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />
        </StackPanel>
    </Border>
</UserControl>
