<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Chatly.Desktop.ViewModels.Windows"
        xmlns:windows="using:Chatly.Desktop.Views.Windows"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:chat="using:Chatly.Desktop.ViewModels.Pages.ChatPage"
        xmlns:controls="using:Chatly.Desktop.Views.Controls"
        x:ClassModifier="internal"
        x:Class="Chatly.Desktop.Views.Windows.MainWindow"
        x:DataType="windows:MainWindow"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="700"
        Icon="/Assets/chatly-logo.ico"
        Title="Chatly"
        Width="1100"
        Height="700"
        MinWidth="1100"
        MinHeight="700">

    <Window.Resources>
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <Button Classes="nav-item" Command="{Binding NavigateCommand}">
                <Grid ColumnDefinitions="64,*">
                    <Border Width="3"
                            Height="20"
                            Background="{DynamicResource ChatlyAccentBrush}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSelected}" />
                    <ic:SymbolIcon Grid.Column="0"
                                   Symbol="{Binding Icon}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ChatlyTextBrush}"
                                   Opacity="0.85"
                                   ToolTip.Tip="{Binding Title}" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ChatItemTemplate" x:DataType="chat:ChatPreviewViewModel">
            <Button Classes="chat-item" Command="{Binding NavigateCommand}">
                <Grid ColumnDefinitions="64,*">
                    <Border Width="3"
                            Height="24"
                            Background="{DynamicResource ChatlyAccentBrush}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSelected}" />
                    <controls:UserAvatar Grid.Column="0" Width="36"
                                         Height="36"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         DisplayName="{Binding Name}"
                                         ProfilePictureUrl="{Binding User.ProfilePictureUrl}"
                                         IsOnline="{Binding User.IsOnline}" />
                    <controls:UnreadBadge Grid.Column="0"
                                          Count="{Binding UnreadMessageCount}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,2,0"
                                          IsVisible="{Binding HasUnreadMessages}" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2"
                                Margin="0,0,20,0">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ChatlyTextBrush}" />
                        <TextBlock Text="{Binding Preview}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border#Sidebar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
        </Style>
        <Style Selector="Button.chat-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chat-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Background="{DynamicResource ChatlyWindowBrush}">
            <Border x:Name="Sidebar"
                    DockPanel.Dock="Left"
                    Width="64"
                    Background="{DynamicResource ChatlySidebarBrush}"
                    BorderBrush="{DynamicResource ChatlyBorderBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                    <!-- Fixed header -->
                    <Border Grid.Row="1"
                            Height="1"
                            Margin="8,0"
                            Background="{DynamicResource ChatlyBorderBrush}" />

                    <ItemsControl Grid.Row="2"
                                  Classes="stretch-items"
                                  Margin="0,4"
                                  ItemsSource="{Binding ViewModel.TopNavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}" />

                    <Border Grid.Row="3"
                            Height="1"
                            Margin="8,0"
                            Background="{DynamicResource ChatlyBorderBrush}" />

                    <ScrollViewer Grid.Row="4"
                                  Margin="0,4"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl Classes="stretch-items"
                                      ItemsSource="{Binding ViewModel.Chats}"
                                      ItemTemplate="{StaticResource ChatItemTemplate}" />
                    </ScrollViewer>

                    <Border Grid.Row="5"
                            Height="1"
                            Margin="8,0"
                            Background="{DynamicResource ChatlyBorderBrush}" />

                    <ItemsControl Grid.Row="6"
                                  Classes="stretch-items"
                                  Margin="0,4,0,8"
                                  ItemsSource="{Binding ViewModel.FooterNavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource ChatlyContentBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="call-bar"
                            Margin="24,24,24,0"
                            IsVisible="{Binding Call.HasCall}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <controls:UserAvatar Width="36"
                                                 Height="36"
                                                 VerticalAlignment="Center"
                                                 DisplayName="{Binding Call.RemoteUsername}"
                                                 ProfilePictureUrl="{Binding Call.RemoteUser.ProfilePictureUrl}"
                                                 IsOnline="{Binding Call.RemoteUser.IsOnline}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Call.RemoteUsername, FallbackValue=Call}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ChatlyTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Call.StatusText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ChatlyMutedTextBrush}" />
                                    <TextBlock Text="{Binding Call.DurationText}"
                                               FontSize="12"
                                               FontFeatures="tnum"
                                               Foreground="{DynamicResource ChatlyMutedTextBrush}"
                                               IsVisible="{Binding Call.ShowDuration}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="fluent-button"
                                        Padding="10,7"
                                        Command="{Binding Call.ToggleMuteCommand}"
                                        IsVisible="{Binding Call.CanLeave}"
                                        ToolTip.Tip="Mute or unmute your microphone">
                                    <Panel>
                                        <ic:SymbolIcon Symbol="Mic" FontSize="18" IsVisible="{Binding !Call.IsMuted}" />
                                        <ic:SymbolIcon Symbol="MicOff" FontSize="18" IsVisible="{Binding Call.IsMuted}" />
                                    </Panel>
                                </Button>
                                <Button Classes="accent-button"
                                        Padding="14,7"
                                        Command="{Binding Call.AcceptCommand}"
                                        IsVisible="{Binding Call.CanAccept}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Call" FontSize="16" />
                                        <TextBlock Text="Accept" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="fluent-button"
                                        Padding="14,7"
                                        Command="{Binding Call.DeclineCommand}"
                                        IsVisible="{Binding Call.CanDecline}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="CallEnd" FontSize="16" />
                                        <TextBlock Text="Decline" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="fluent-button"
                                        Padding="14,7"
                                        Command="{Binding Call.LeaveCallCommand}"
                                        IsVisible="{Binding Call.CanCancel}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="fluent-button"
                                        Padding="14,7"
                                        Command="{Binding Call.LeaveCallCommand}"
                                        IsVisible="{Binding Call.CanLeave}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="CallEnd" FontSize="16" />
                                        <TextBlock Text="Leave" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ContentControl Content="{Binding ViewModel.CurrentPage}" Grid.Row="1" Margin="24" />
                </Grid>
            </Border>
        </DockPanel>

        <ContentControl x:Name="CallMediaContainer" />
        <ContentControl x:Name="PopupHostContainer" />
        <ContentControl x:Name="ToastHostContainer" />

    </Grid>

</Window>