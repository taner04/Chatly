<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:vm="using:Chatly.Desktop.ViewModels.Windows"
         xmlns:windows="using:Chatly.Desktop.Views.Windows"
         xmlns:ic="using:FluentIcons.Avalonia"
         xmlns:popups="clr-namespace:Chatly.Desktop.Views.Popups"
         xmlns:toasts="clr-namespace:Chatly.Desktop.Views.Toasts"
        x:Class="Chatly.Desktop.Views.Windows.MainWindow"
        x:Name="RootWindow"
         x:DataType="windows:MainWindow"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="700"
        Icon="/Assets/avalonia-logo.ico"
        Title="Chatly"
        Width="1100"
        Height="700"
        MinWidth="1100"
        MinHeight="700">

    <Window.Resources>
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <Button Classes="nav-item" Command="{Binding NavigateCommand}">
                <Grid ColumnDefinitions="48,*">
                    <Border Width="3"
                            Height="20"
                            Background="{DynamicResource ChatlyAccentBrush}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSelected}" />
                    <ic:SymbolIcon Grid.Column="0"
                                   Symbol="{Binding Icon}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ChatlyTextBrush}"
                                   Opacity="0.85" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="13"
                               Foreground="{DynamicResource ChatlyTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border#Sidebar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.sidebar-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Background="{DynamicResource ChatlyWindowBrush}">
            <Border x:Name="Sidebar"
                    DockPanel.Dock="Left"
                    Width="48"
                    Background="{DynamicResource ChatlySidebarBrush}"
                    BorderBrush="{DynamicResource ChatlyBorderBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <!-- Fixed header -->
                    <Button Classes="sidebar-toggle"
                            Grid.Row="0"
                            HorizontalAlignment="Left"
                            Click="SidebarToggle_OnClick">
                        <TextBlock x:Name="SidebarToggleIcon"
                                   Text=">"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>

                    <Border Grid.Row="1"
                            Height="1"
                            Margin="8,0"
                            Background="{DynamicResource ChatlyBorderBrush}" />

                    <!-- Scrollable primary navigation -->
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,4"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ViewModel.NavigationItems}"
                                      ItemTemplate="{StaticResource NavigationItemTemplate}">
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.Styles>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            Height="1"
                            Margin="8,0"
                            Background="{DynamicResource ChatlyBorderBrush}" />

                    <!-- Fixed footer navigation -->
                    <ItemsControl Grid.Row="4"
                                  Margin="0,4,0,8"
                                  ItemsSource="{Binding ViewModel.FooterNavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Background="{DynamicResource ChatlyContentBrush}" Margin="18,22,22,22" CornerRadius="18">
                <ContentControl x:Name="PageHost" Margin="24" />
            </Border>
        </DockPanel>

        <ContentControl x:Name="PopupHostContainer" />
        <ContentControl x:Name="ToastHostContainer" />
    </Grid>

</Window>
