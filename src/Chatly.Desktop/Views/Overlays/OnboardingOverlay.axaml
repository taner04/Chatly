<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:overlays="using:Chatly.Desktop.Views.Overlays"
             x:Class="Chatly.Desktop.Views.Overlays.OnboardingOverlay"
             x:DataType="overlays:OnboardingOverlay"
             x:Name="Root"
             d:DesignWidth="512"
             d:DesignHeight="390"
             mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBox.profile-input">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ChatlyContentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ChatlyTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="TextBox.profile-input:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyAccentBrush}" />
        </Style>

        <Style Selector="Button.avatar-button">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="36" />
            <Setter Property="Background" Value="{DynamicResource ChatlyContentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.avatar-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ChatlyHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatlyAccentBrush}" />
        </Style>

        <Style Selector="Button.continue-button">
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ChatlyAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="22">
        <TextBlock Text="Choose a username and, if you like, add a profile picture."
                   FontSize="14"
                   Foreground="{DynamicResource ChatlyMutedTextBrush}" />

        <StackPanel HorizontalAlignment="Center" Spacing="8">
            <Grid Width="76" Height="76">
                <Button Classes="avatar-button"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding ViewModel.SelectProfilePictureCommand}"
                        CommandParameter="{Binding #Root}">
                    <Border Width="70"
                            Height="70"
                            CornerRadius="35"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ViewModel.ProfilePicturePreview}"
                                   IsVisible="{Binding ViewModel.HasProfilePicturePreview}"
                                   Stretch="UniformToFill" />
                            <Grid Width="14"
                                  Height="14"
                                  IsVisible="{Binding !ViewModel.HasProfilePicturePreview}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border Width="14"
                                        Height="2"
                                        CornerRadius="1"
                                        Background="{DynamicResource ChatlyMutedTextBrush}" />
                                <Border Width="2"
                                        Height="14"
                                        CornerRadius="1"
                                        Background="{DynamicResource ChatlyMutedTextBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Button>

                <Button Width="22"
                        Height="22"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="11"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsVisible="{Binding ViewModel.HasProfilePicturePreview}"
                        Background="{DynamicResource ChatlyContentBrush}"
                        BorderBrush="{DynamicResource ChatlyBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource ChatlyTextBrush}"
                        Command="{Binding ViewModel.RemoveProfilePictureCommand}">
                    <Grid Width="9"
                          Height="9"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Border Width="10"
                                Height="1.5"
                                CornerRadius="1"
                                Background="{DynamicResource ChatlyTextBrush}"
                                RenderTransformOrigin="50%,50%"
                                RenderTransform="rotate(45deg)" />
                        <Border Width="10"
                                Height="1.5"
                                CornerRadius="1"
                                Background="{DynamicResource ChatlyTextBrush}"
                                RenderTransformOrigin="50%,50%"
                                RenderTransform="rotate(-45deg)" />
                    </Grid>
                </Button>

                <Border Width="22"
                        Height="22"
                        CornerRadius="11"
                        IsVisible="{Binding !ViewModel.HasProfilePicturePreview}"
                        Background="{DynamicResource ChatlyAccentBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False">
                    <Grid Width="9"
                          Height="9"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Border Width="9"
                                Height="1.5"
                                CornerRadius="1"
                                Background="White" />
                        <Border Width="1.5"
                                Height="9"
                                CornerRadius="1"
                                Background="White" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="Add picture"
                       FontSize="13"
                       IsVisible="{Binding !ViewModel.HasProfilePicturePreview}"
                       Foreground="{DynamicResource ChatlyAccentBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ViewModel.ProfilePicture.Name}"
                       Width="260"
                       FontSize="13"
                       IsVisible="{Binding ViewModel.HasProfilePicturePreview}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ChatlyMutedTextBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="7">
            <TextBlock Text="Username"
                       FontSize="13"
                       Foreground="{DynamicResource ChatlyMutedTextBrush}" />
            <TextBox Classes="profile-input"
                     Text="{Binding ViewModel.Username, Mode=TwoWay}"
                     PlaceholderText="Username"
                     MaxLength="30" />
        </StackPanel>

        <Button Classes="continue-button"
                Content="Continue"
                Command="{Binding ViewModel.CompleteOnboardingCommand}" />
    </StackPanel>
</UserControl>
