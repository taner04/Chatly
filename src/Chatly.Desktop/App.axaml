<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chatly.Desktop.App"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Chatly.Desktop/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="avares://Chatly.Desktop/Styles/ComboBoxStyles.axaml" />
        <StyleInclude Source="avares://Chatly.Desktop/Styles/SelectionControlStyles.axaml" />
        <StyleInclude Source="avares://Chatly.Desktop/Styles/TextBoxStyles.axaml" />
        <StyleInclude Source="avares://Chatly.Desktop/Styles/BorderStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Chatly.Desktop/Styles/ChatlyTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>